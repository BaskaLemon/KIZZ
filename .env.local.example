# Copy to .env.local (gitignored) and fill in real values for local dev.

# Postgres connection string (e.g. from a Supabase project: Settings -> Database -> Connection string).
DATABASE_URL=postgres://user:password@host:5432/database

# Random secret used to sign/verify auth tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Needed to generate quizzes from notes (Gemini). Everything else works without it.
GEMINI_API_KEY=

# Shown on the Terms/Privacy pages so people can reach you (optional).
NEXT_PUBLIC_CONTACT_EMAIL=
