# Copy to .env.local (gitignored) and fill in real values for local dev.

# Postgres connection string (e.g. from a Supabase project: Settings -> Database -> Connection string).
DATABASE_URL=postgres://user:password@host:5432/database

# Random secret used to sign/verify auth tokens. Generate one with:
#   openssl rand -base64 32
AUTH_SECRET=

# Optional: enables "AI" mode for quiz generation (falls back to rule-based mode if unset).
GEMINI_API_KEY=
