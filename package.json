{
  "name": "kizz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "jest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:seed": "bun --env-file=.env.local run src/db/seed.ts",
    "test:unit": "bun test src",
    "test:e2e": "bun --env-file=.env.local run scripts/e2e.ts; bun --env-file=.env.local run scripts/e2e-cleanup.ts"
  },
  "dependencies": {
    "@dicebear/big-smile": "^9.4.2",
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.2",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "jose": "^6.2.12",
    "lucide-react": "^1.34.0",
    "next": "~16.1.6",
    "next-themes": "^0.4.6",
    "postgres": "^3.4.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.0",
    "@testing-library/react": "16.3.0",
    "@types/bun": "^1.4.2",
    "@types/jest": "^30.0.0",
    "@types/node": "^25.7.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "10.4.13",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.8.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^30.0.2",
    "jest-environment-jsdom": "^30.0.2",
    "postcss": "8.4.38",
    "tailwindcss": "3.4.3",
    "typescript": "~5.9.2"
  }
